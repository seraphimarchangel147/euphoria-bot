# Copy to .env and fill in. .env is gitignored.

# Wallet that signs TakerOrders (MegaETH). Required.
EUPHORIA_PRIVATE_KEY=

# PREFERRED: self-renewing Privy refresh token. Capture once, see docs/AUTH.md.
EUPHORIA_PRIVY_REFRESH_TOKEN=

# Alternative one-off: a raw identity token (expires in ~1 hour).
EUPHORIA_PRIVY_IDENTITY_TOKEN=

# Optional: cookies posted by the extension (or pasted here). Never commit these.
# EUPHORIA_PRIVY_TOKEN=
# EUPHORIA_PRIVY_ID_TOKEN=
# EUPHORIA_PRIVY_SESSION=
# EUPHORIA_PRIVY_USER_ID=

# Operator control room (localhost only)
# EUPHORIA_CONTROL_PORT=8765

# Non-US SOCKS5 proxy for the geo-block. Leave empty to auto-discover.
EUPHORIA_PROXY=

# Safety rails
EUPHORIA_DRY_RUN=1
EUPHORIA_MAX_TRADE_USDM=10
EUPHORIA_MAX_DAILY_LOSS_USDM=50
EUPHORIA_MAX_OPEN_TRADES=3

# Optional monitoring
EUPHORIA_DISCORD_WEBHOOK=
EUPHORIA_SYMBOLS=ETH,BTC
EUPHORIA_ALERT_THRESHOLD=0.01
