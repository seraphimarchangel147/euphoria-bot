{
  "manifest_version": 3,
  "name": "Euphoria Operator Bridge",
  "version": "0.1.0",
  "description": "Forwards logged-in Euphoria prices, session cookies, and an advisory overlay to the local control room. Does not debug Chrome, solve captchas, or mint trade artefacts.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": [
    "https://euphoria.finance/*",
    "https://*.euphoria.finance/*",
    "https://api.mainnet.euphoria.finance/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://euphoria.finance/*", "https://www.euphoria.finance/*"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js"],
      "matches": ["https://euphoria.finance/*", "https://www.euphoria.finance/*"]
    }
  ]
}
